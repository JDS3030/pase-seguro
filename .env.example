# ════════════════════════════════════════════════════════════════════════════════
# PASEO SEGURO — Configuración de Ambiente
# ════════════════════════════════════════════════════════════════════════════════
#
# IMPORTANTE:
# - .env.local NO debe ser commiteado a git (está en .gitignore)
# - En Vercel, configurar estas variables en: Project Settings → Environment Variables
# - NUNCA incluir secretos en repositorio público
#
# ════════════════════════════════════════════════════════════════════════════════

# ── Base de Datos (PostgreSQL) ─────────────────────────────────────
# Local: postgresql://paseo:paseo@localhost:5432/paseo_seguro
# Vercel: Usar Vercel Postgres o servicio externo
DATABASE_URL="postgresql://paseo:paseo@localhost:5432/paseo_seguro"

# ── DeepSeek Chat API (Chatbot) ────────────────────────────────────
# 🔐 NUNCA exponer en frontend
# Obtén en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-..."

# ── Stripe (Pagos) ────────────────────────────────────────────────
# Test: https://dashboard.stripe.com/test/apikeys
# Producción: usar claves sk_live_
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Open-Meteo API (Pronóstico) ────────────────────────────────────
# APIs públicas, sin autenticación requerida
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"

# ── Reglas de Negocio ──────────────────────────────────────────────
RAIN_THRESHOLD_PCT=60
WEATHER_DISCOUNT_BPS=2000
FORECAST_MAX_DAYS=14
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_STALE_TOLERANCE_SECONDS=21600

# ── Aplicación ────────────────────────────────────────────────────
# Local: http://localhost:3000 (backend)
# Vercel: https://paseo-seguro.vercel.app
APP_URL="http://localhost:3000"

# Frontend URL (para redirecciones post-pago)
# Local: http://localhost:5173
# Vercel: https://paseo-seguro.vercel.app
FRONTEND_URL="http://localhost:5173"

# Secret para firmar tokens HMAC
# Generar: openssl rand -base64 32
# 🔐 Cambiar en producción
QUOTE_SIGNING_SECRET="cambiar-en-produccion-con-openssl-rand-base64-32"

# ── Modo Desarrollo ────────────────────────────────────────────────
# true = Mock de Stripe (sin pagos reales)
# false = Stripe real (requiere claves live)
MOCK_STRIPE=true
